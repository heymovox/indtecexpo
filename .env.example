# Admin panel credentials. Required — the app throws on login if unset.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Signs the admin session cookie (HMAC-SHA256). Required.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# AES-256-GCM key for encrypting PII at rest in .data/. Required.
# Changing this makes previously encrypted local records unreadable.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=