# Admin accounts live in Postgres (`admin_users`) with scrypt-hashed passwords.
# ADMIN_EMAIL / ADMIN_PASSWORD are a FIRST-RUN BOOTSTRAP ONLY: while the
# `admin_users` table is empty, the first successful login seeds a superadmin
# from these values. Once seeded, the database is the only source of truth and
# you should clear ADMIN_PASSWORD from .env and from Vercel.
#
#   node scripts/migrate.mjs                       # creates admin_users + admin_sessions
#   node scripts/admin-user.mjs add you@heymovox.com 'a-long-password' superadmin 'Your Name'
#
# ADMIN_SESSION_SECRET is always required — it signs the session cookie.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# AES-256-GCM key for encrypting PII at rest in the database. Required.
# Changing this makes previously encrypted records unreadable.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=

# Postgres connection string (Neon). Required for the contact, visitor
# registration and stall booking forms, the admin accounts, and the admin
# dashboard. The public site still renders without it — other pages use static data.
# Create the tables once with:  node scripts/migrate.mjs
DATABASE_URL=

# Optional. POSTs form notifications to your email provider (Resend, SendGrid,
# Zapier, ...). When unset, notifications are written to the server log.
# NOTIFICATION_WEBHOOK_URL=
# NOTIFICATION_WEBHOOK_TOKEN=
# NOTIFICATION_FROM=

# Cloudflare R2 file storage. Optional — when unset the admin Media, Gallery and
# Floor Plans uploaders report "Storage not configured" and hide themselves.
# Required together, all four, to enable uploads.
# Account ID and bucket name come from the Cloudflare dashboard. Create a
# bucket-scoped API token with Object Read & Write, then grant it access to the
# bucket. The bucket can stay private: previews stream through the app and
# "Copy link" issues one-hour presigned URLs.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional. Base URL for publicly served assets, e.g. a custom domain
# (https://media.heymovox.com) or the r2.dev dev subdomain. Leave blank to use
# presigned URLs, which expire after an hour.
# R2_PUBLIC_URL=